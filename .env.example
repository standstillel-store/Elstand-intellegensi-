# ---------------------------------------------------------------------------
# This file only documents the env vars added for Phase 6.6.0.1 (private
# admin dashboard). The rest of the project's env vars (Supabase, Binance,
# wallet/RPC, rewards, etc.) are already configured directly in your
# deployment's env settings (e.g. Vercel > Project > Settings >
# Environment Variables) and were never collected into a single
# .env.example before this — add them here too if you want one canonical
# reference, but that's outside this phase's scope.
# ---------------------------------------------------------------------------

# Private admin entry path — the URL segment that reveals the admin login
# page (e.g. https://yourdomain.com/<this value>). Generate a long random
# url-safe string yourself; do NOT reuse the example in Phase 6.6.0.1's
# spec doc. This is obscurity, not authentication — ADMIN_PASSWORD_HASH is
# what actually protects the dashboard.
ADMIN_ENTRY_PATH=

# scrypt hash of the admin password — generate with:
#   node scripts/hash-admin-password.js "your-password-here"
# Never put the plaintext password in any env var or in source control.
ADMIN_PASSWORD_HASH=

# Long random secret used to sign the admin session cookie (HMAC-SHA256)
# and to hash IPs for rate limiting / audit logs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Phase 6.6.1 — Bug Hunter (BugBountyEscrow integration)
# ---------------------------------------------------------------------------

# Deployed BugBountyEscrow.sol address on BSC Testnet (chain 97).
BUG_BOUNTY_ESCROW_ADDRESS=

# Private key of the OPERATIONAL wallet used ONLY for the owner-only calls
# createBounty / fundBounty / approveBounty. This wallet must:
#   1. Be the `owner()` of the deployed BugBountyEscrow contract (or have
#      had ownership transferred to it) — same pattern as
#      REWARD_DISTRIBUTOR_OPERATOR_PRIVATE_KEY.
#   2. Have already called `approve(spender: BUG_BOUNTY_ESCROW_ADDRESS,
#      amount: <large ELS allowance>)` on the ELS token, once, manually —
#      see deployment steps in the Phase 6.6.1 report.
# NEVER used to call claimBounty() — that is signed exclusively by the
# researcher's own connected wallet in the browser. Never expose this key
# to the browser.
BUG_BOUNTY_ESCROW_OPERATOR_PRIVATE_KEY=

# Optional — defaults to the public BSC Testnet RPC already used elsewhere
# in this project if unset.
BSC_TESTNET_RPC_URL=

# Gmail SMTP (App Password, not the main account password) for Bug Hunter
# email notifications (admin new-report alert, user approved/rejected).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=standstillel@gmail.com
SMTP_PASSWORD=

# Where the "new bug report" notification email is sent. Defaults to
# standstillel@gmail.com if unset.
BUG_HUNTER_ADMIN_EMAIL=standstillel@gmail.com
